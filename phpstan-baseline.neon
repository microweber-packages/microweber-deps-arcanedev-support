			path: src/Database/Migration.php

		-
			message: '#^Unsafe usage of new static\(\)\.$#'
			identifier: new.static
			count: 1
			path: src/Exceptions/PackageException.php

		-
			message: '#^Function base_path not found\.$#'
			identifier: function.notFound
			count: 1
			path: src/Providers/PackageServiceProvider.php

