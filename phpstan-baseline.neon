		-
			message: '#^Class Illuminate\\Routing\\Router not found\.$#'
			identifier: class.notFound
			count: 1
			path: src/Routing/RouteRegistrar.php

		-
			message: '#^Function app not found\.$#'
			identifier: function.notFound
			count: 3
			path: src/Routing/RouteRegistrar.php

		-
			message: '#^PHPDoc tag @method for method Arcanedev\\Support\\Routing\\RouteRegistrar\:\:bind\(\) return type contains unknown class Illuminate\\Routing\\RouteRegistrar\.$#'
			identifier: class.notFound
			count: 1
			path: src/Routing/RouteRegistrar.php

		-
			message: '#^PHPDoc tag @mixin contains unknown class Illuminate\\Routing\\RouteRegistrar\.$#'
			identifier: class.notFound
			count: 1
			path: src/Routing/RouteRegistrar.php

		-
			message: '#^Method Arcanedev\\Support\\Stub\:\:create\(\) should return \$this\(Arcanedev\\Support\\Stub\) but returns static\(Arcanedev\\Support\\Stub\)\.$#'
			identifier: return.type
			count: 1
			path: src/Stub.php

		-
			message: '#^Method Arcanedev\\Support\\Stub\:\:createFromPath\(\) should return \$this\(Arcanedev\\Support\\Stub\) but returns static\(Arcanedev\\Support\\Stub\)\.$#'
			identifier: return.type
